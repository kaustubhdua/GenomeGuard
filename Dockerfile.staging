# Synthetic-only staging image. Unlike the public research image, this deliberately
# does not download, build, or embed any real genomic cohort.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY backend ./backend
RUN pip install -e .
COPY frontend ./frontend
COPY docs ./docs
COPY scripts ./scripts
ENV GG_DB_PATH=/data/genomeguard.sqlite3 PORT=8000 GG_DATASET_ID=synthetic-cohort-1
RUN useradd -m app && mkdir -p /data && chown app /data
USER app
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT}"]
