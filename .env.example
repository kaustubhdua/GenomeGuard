# GenomeGuard environment variables
# Copy this file to .env and fill in values for your deployment.
# All variables are prefixed GG_ except the three LLM key shortcuts below.
#
# The application works fully without any of these variables set (demo mode
# with synthetic data, built-in template agents, local SQLite database).

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset to use local SQLite (default, fine for dev / demo).
# Set to a PostgreSQL URL for production persistent storage.
# GG_DATABASE_URL=postgresql://user:pass@host:5432/genomeguard

# ── Security ──────────────────────────────────────────────────────────────────
# Required in non-demo mode. Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# GG_MASTER_KEY=<base64-encoded 32-byte random key>

# Required in non-demo mode. Must be at least 32 characters.
# GG_ADMIN_API_KEY=<long-random-secret>

# ── AI Agents (all optional — built-in templates are used when unset) ─────────
# Provide at most ONE provider key. The system auto-detects the provider from
# the key prefix (AIza→Gemini, sk-ant-→Anthropic, sk-→OpenAI).
#
# Option A: Google Gemini (free tier available — https://aistudio.google.com/apikey)
# GEMINI_API_KEY=AIza...
#
# Option B: Anthropic Claude (paid — https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option C: OpenAI (paid — https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...
#
# Override provider / model explicitly if needed:
# GG_LLM_PROVIDER=gemini
# GG_LLM_MODEL=gemini-2.5-flash

# ── Dataset ───────────────────────────────────────────────────────────────────
# GG_DATASET_ID=synthetic-cohort-1
# GG_DEMO_MODE=true
# GG_REAL_COHORT_FILE=/path/to/real-cohort.vcf.gz
